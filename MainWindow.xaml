<Window x:Class="WpeRemix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:WpeRemix.Core"
        Title="WpeRemix" Icon="{StaticResource BrandIcon}" Width="1200" Height="820" MinWidth="1000" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowDrop="True"
        PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop" Closing="Window_Closing">
    <Border BorderBrush="#363636" BorderThickness="1" Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid>
                <Grid Margin="24,22,24,20">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.06*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                    <Border x:Name="QueuePanel" Grid.RowSpan="2" Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" MouseLeftButtonUp="QueuePanel_MouseLeftButtonUp">
                        <Grid>
                            <Button Click="AddFolder_Click" IsEnabled="{Binding CanEdit}" Padding="18" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ToolTip="选择多个文件夹，也可直接拖入文件夹或壁纸包" AutomationProperties.Name="选择文件夹或拖入壁纸包">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DropZoneButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding JobCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                <Grid IsHitTestVisible="False">
                                    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M3,17 L3,23 L25,23 L25,17 M14,19 L14,3 M8,9 L14,3 L20,9" Width="32" Height="32" Stretch="Uniform" Stroke="#C9C9C9" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                        <TextBlock Text="拖入文件夹或壁纸包" FontSize="13" LineHeight="18" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Row="2" Height="{Binding ActualHeight, ElementName=OutputRow}" Margin="0,16,0,0" />
                                </Grid>
                            </Button>
                            <Grid Margin="18">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Height="34" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="处理队列" FontSize="14" FontWeight="SemiBold" />
                                        <Border Background="#303030" CornerRadius="6" Padding="7,2" Margin="9,0,0,0"><TextBlock Text="{Binding JobCount}" FontSize="12" Foreground="#BDBDBD" /></Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Click="AddFiles_Click" IsEnabled="{Binding CanEdit}" ToolTip="添加多个文件或文件夹" AutomationProperties.Name="添加多个文件或文件夹">
                                            <Path Data="M2,1 L9,1 L14,6 L14,15 L2,15 Z M9,1 L9,6 L14,6 M8,8 L8,13 M5.5,10.5 L10.5,10.5" Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Click="AddFolder_Click" IsEnabled="{Binding CanEdit}" ToolTip="添加一个或多个壁纸文件夹" AutomationProperties.Name="添加壁纸文件夹" Margin="3,0,0,0">
                                            <Path Data="M1,3 L6,3 L8,5 L17,5 L17,15 L1,15 Z M1,6 L17,6 M9,8 L9,13 M6.5,10.5 L11.5,10.5" Width="18" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Click="Clear_Click" IsEnabled="{Binding CanEdit}" ToolTip="清空处理队列" AutomationProperties.Name="清空队列" Margin="3,0,0,0">
                                            <Path Data="M2,4 L16,4 M6,4 L6,2 L12,2 L12,4 M4,4 L5,16 L13,16 L14,4 M7,7 L7.5,13 M11,7 L10.5,13" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" MinHeight="90">
                                    <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.Name="待处理和已完成任务">
                                        <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding JobCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Grid>
                                                                <Border x:Name="ItemBorder" Background="#242424" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" />
                                                                <Border x:Name="InteractionBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" />
                                                                <ContentPresenter Margin="1" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1C3049" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#344F70" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#293440" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#52677E" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="失败"><Setter TargetName="ItemBorder" Property="Background" Value="#3A2528" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#75434A" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="已取消"><Setter TargetName="ItemBorder" Property="Background" Value="#282828" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#424242" /></DataTrigger>
                                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="InteractionBorder" Property="BorderBrush" Value="#8090A3" /><Setter TargetName="InteractionBorder" Property="Background" Value="#0AFFFFFF" /></Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InteractionBorder" Property="Background" Value="#12FFFFFF" /></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="11,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                                    <Path Data="M2,1 L12,1 L17,6 L17,21 L2,21 Z M12,1 L12,6 L17,6 M5,12 L14,12 M5,16 L12,16" Width="20" Height="23" Stroke="#B0B0B0" StrokeThickness="1.2" StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <StackPanel Grid.Column="1" Margin="0,0,9,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#969696" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="3" Margin="0,9,0,0">
                                                            <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Setter Property="Visibility" Value="Hidden" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Click="RemoveJob_Click" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="从队列移除此任务">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" /><Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></MultiDataTrigger>
                                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" /><Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></MultiDataTrigger>
                                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="#454545" /><Setter Property="Foreground" Value="#F0F0F0" /></MultiDataTrigger>
                                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="#535353" /><Setter Property="Foreground" Value="#FFFFFF" /></MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Path Data="M4,4 L14,14 M14,4 L4,14" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                            <Border Background="#F0171717" BorderBrush="#A6A6A6" BorderThickness="2" CornerRadius="12" IsHitTestVisible="False" Visibility="{Binding ShowDropOverlay, Converter={StaticResource BoolVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="松开，添加到队列" FontSize="24" FontWeight="SemiBold" Foreground="#EEEEEE" /><TextBlock Text="支持多个壁纸包和文件夹" FontSize="13" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,15,0,0" /></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="PreviewPanel" Grid.Column="2" Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="12">
                        <Grid Margin="18">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Height="34" Margin="0,0,0,14">
                                <TextBlock Text="画面预览" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="CompositionInfoButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="CompositionInfo_Click" AutomationProperties.Name="查看合成范围说明" AutomationProperties.HelpText="{x:Static core:CompositionNotices.Overview}">
                                    <Grid Width="18" Height="18"><Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /><Path Data="M9,8 L9,13 M9,5 L9,5.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Grid>
                                </Button>
                            </Grid>
                            <Grid x:Name="PreviewViewport" Grid.Row="1" SizeChanged="PreviewLayout_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.Style><Style TargetType="Grid"><Setter Property="MinHeight" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}"><Setter Property="MinHeight" Value="{Binding MaxHeight, ElementName=PreviewResultImage}" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                <Image x:Name="PreviewResultImage" Source="{Binding PreviewImage}" Stretch="Uniform" VerticalAlignment="Top" MaxHeight="140" AutomationProperties.Name="合成结果预览" />
                                        </Grid>
                                        <StackPanel x:Name="PreviewDetails" Margin="0,14,0,0" SizeChanged="PreviewLayout_SizeChanged" Visibility="{Binding HasSelectedJob, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="{Binding PreviewTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PreviewCaption}" FontSize="12" Foreground="#929292" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding HasPreviewCaption, Converter={StaticResource BoolVisibility}}" />
                                            <Button Style="{StaticResource PathButton}" Click="OpenSelectedPath_Click" IsEnabled="{Binding CanOpenSelectedPath}" Margin="0,9,0,0" ToolTip="在资源管理器中打开对应文件夹" AutomationProperties.Name="打开路径所在文件夹"><TextBlock Text="{Binding SelectedPath}" FontSize="12" TextWrapping="Wrap" /></Button>
                                            <TextBox x:Name="ReportTextBox" Text="{Binding SelectedDetail, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" FontSize="12" Foreground="#A5A5A5" Margin="0,9,0,0" Visibility="{Binding HasSelectedReport, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="处理报告，可选择文字并复制" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Path Data="M2,2 L34,2 L34,28 L2,28 Z M2,22 L12,12 L21,21 L26,16 L34,24 M26,8 L26,9" Width="32" Height="32" Stretch="Uniform" Stroke="#585858" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding PreviewPlaceholder}" FontSize="13" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="#8C8C8C" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="15,0" />
                                </StackPanel>
                                <StackPanel x:Name="PreviewActions" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" SizeChanged="PreviewLayout_SizeChanged" Visibility="{Binding CanOpenImage, Converter={StaticResource BoolVisibility}}">
                                    <Button Style="{StaticResource IconTextButton}" Click="OpenImage_Click" IsEnabled="{Binding CanOpenImage}" AutomationProperties.Name="打开选中的合成图片">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M2,2 L15,2 L15,15 L2,15 Z M2,12 L6,8 L10,12 L12,10 L15,13 M11,6 L11,6.5" Width="17" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="打开图片" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="CompositionInfoCard" Grid.RowSpan="2" Margin="0,38,0,0" Panel.ZIndex="10" Width="360" MaxWidth="{Binding ActualWidth, ElementName=PreviewViewport}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Padding="16" PreviewKeyDown="CompositionInfo_PreviewKeyDown" AutomationProperties.Name="合成范围说明">
                                <StackPanel>
                                    <TextBlock Text="合成范围" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <TextBlock Text="{x:Static core:CompositionNotices.Overview}" FontSize="12" Foreground="#D0D0D0" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid x:Name="OutputRow" Grid.Row="1" Grid.Column="2" Height="46" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border x:Name="OutputPathBorder" Height="46" Background="#1E1E1E" CornerRadius="8" BorderThickness="1" VerticalAlignment="Center">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#3A3A3A" /><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#808080" /></Trigger></Style.Triggers></Style></Border.Style>
                            <Grid Margin="3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0" Padding="9,6" FontSize="12" VerticalContentAlignment="Center" AutomationProperties.Name="输出文件夹路径" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="3,0,1,0" Click="ChooseOutput_Click" IsEnabled="{Binding CanEdit}" ToolTip="选择输出目录" AutomationProperties.Name="选择输出目录">
                                    <Path Data="M1,3 L6,3 L8,5 L17,5 L17,15 L1,15 Z M1,6 L17,6" Width="18" Height="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                                </Button>
                            </Grid>
                        </Border>
                        <Button x:Name="ProcessActionButton" Grid.Column="1" Content="{Binding StartLabel}" Style="{StaticResource PrimaryButton}" Width="132" Height="46" Margin="12,0,0,0" Padding="14,10" Click="Start_Click" IsEnabled="{Binding CanUsePrimaryAction}" FontSize="14" AutomationProperties.Name="{Binding StartLabel}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
